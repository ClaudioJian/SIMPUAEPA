#===================================================================================
# INFORMATION & USER GUIDE
#===================================================================================
#c: CRITICAL: Do not move or change the location of this file. If you must relocate it,
#c: update the corresponding path constants inside 'Include/ENV_const.h' and recompile.
#c: 
#c: Runtime Execution: All configurations declared below are evaluated at runtime. 
#c: You can modify them freely, but you must adhere to the formatting syntax below 
#c: to prevent application errors or unexpected parsing behavior.
#c:
#c: Compilation Note: These keys act as blueprints. To generate a fresh '.env' file 
#c: containing these values, edit this template (or '.env.example') and run setup.exe.

#===================================================================================
# SYSTEM FLAGS & SYNTAX DIRECTIVES
#===================================================================================
#c: #c: -> Comment Escape: Escapes processing flags (l:, r:, s:, e:, o:, f:). Use this 
#c:        prefix to write developer notes containing flag characters safely.
#c:
#c:  l: -> Label / Description: Displays a prompt explaining the value's purpose. 
#c:        The console output will automatically prefix this text as: "Please set {text}"
#c:
#c:  r: -> Required Input: Marks the parameter as mandatory. The setup wizard will 
#c:        block empty values and force user input.
#c:
#c:  s: -> Static / Read-Only: Fixes the variable to its default value. It cannot be 
#c:        modified by the operator at runtime and cannot be left blank.
#c:        (If existing previous data, the conflict can be solved in run time)
#c:
#c:  e: -> Empty / Optional: Explicitly allows an empty value. If the user enters 
#c:        "null", the parameter will bypass generation and won't be written to '.env'.
#c:
#c:  o: -> Options List: Provides a pipe-separated (`|`) list of valid choices. 
#c:        Operators must type a positive integer to pick an option. If no options, 
#c:        the flag is automatically ignored.
#c:
#c:  f: -> Script Execution: WARNING: DO NOT USE THIS FLAG INSIDE THIS FILE. Declaring 
#c:        execution routines here will corrupt the output structure of your '.env' file. 
#c:        To run setup scripts, declare them inside 'internal.cfg' instead.

#===================================================================================
# COMPILER RESTRICTIONS & VALIDATION RULES
#===================================================================================
#c: Flag Priority: Behavior modifiers (r, s, e) are mutually exclusive per variable. 
#c: If duplicate metadata flags are specified, only the final declared flag is used.
#c:
#c: Environment Integrity: Before adding or modifying environment keys, verify that 
#c: your backend/frontend applications and microservices are compatible with the new names.
#c:
#c: Memory Allocation: Key and value string lengths are constrained by hardware buffer sizes. 
#c: Adjust limits inside 'Include/ENV_const.h' and recompile if larger bounds are needed.
#c:
#c: Script Restrictions: The underlying interpreter natively executes '.php' files only.
#c: You can trigger .sql file via php script instead
#c:
#c: Naming Conventions: Environment variable keys cannot begin with numbers or restricted 
#c: special characters (e.g., [ ] , @ $ % \). For keys referencing files, standard system 
#c: file path rules apply (Note: this character validation filter is not entirely strict).
#===================================================================================

#c:====================================values=====================================================

#c: don't change this value's key name, unless you change in ENV_const.h and re-compile it.
#o: development|production|NULL
#l: Server environment. Affects the .env file suffix (NULL = without suffix) e.g., development -> .env.development
ENVIRONMENT = development

#l: where is php location
PHP_PATH = c:\xampp\php

#c:==================================================================================================================================
#c: DATABASE CONFIGURATION
#c:==================================================================================================================================

#l: what application database you are using
#o: mysql
DATABASE_TYPE = mysql

#l:host of database, example: localhost, IP address, or domain name.
DATABASE_HOST = localhost

#l:name of database
DATABASE_NAME = SIMPUAEPA

#l:username for backend to access database
DATABASE_USER = root

#l:password to access database
#r:
DATABASE_PASSWORD = password

#l:port to acess database
#e:
DATABASE_PORT = 3306

#c:==================================================================================================================================
#c: Session control
#c:==================================================================================================================================

#l: Maximum idle time (in seconds) before an inactive user is logged out
SESSION_ACTIVE_TIME = 600

#l: Maximum total session lifespan (in seconds) before forcing a log out, regardless of activity
SESSION_ABSOLUTE_TIME = 4800

#l: time(in seconds) that an session's data alive before is forced to log out(important: still invalid if acess)
SESSION_OBSOLETE_MAXLIFE = 300

#c:==================================================================================================================================
#c: security
#c:==================================================================================================================================

#l: time(in second) to expire CSRF token
CSRF_TOKEN_MAXLIFE = 300

#l: name of header when client send token
#s:
CSRF_TOKEN_HEADER_NAME = X-CSRF-TOKEN

#l: max life of unique request in second
REQUEST_MAX_LIFE = 60

#c:==================================================================================================================================
#c: file upload
#c:==================================================================================================================================

#l: maxium profile size(format:M|K|B|MB|KB|BYTE)
IMG_PROFILE_MAX_SIZE = 1M

#l: final resolution after sucessfully upload profile image(format must be widthxheight)
IMG_PROFILE_FINAL_RESOLUTION = 512x512

#l: maxium size of user uploaded map image(format:M|K|B|MB|KB|BYTE)
IMG_MAP_MAX_SIZE = 10M

#l: final resolution after sucessfully upload map image(format must be widthxheight)
IMG_MAP_FINAL_RESOLUTION = 1920x1080

#l: quality in % for stored image aftewr sucess upload
IMG_FINAL_QUALITY = 80

#o: true|false
#l: control whether to compress file to webp.
IMG_COMPRESS = true

#c:==================================================================================================================================
#c: Log system
#c:==================================================================================================================================

#l: name of file to write log internal error(sufix with .log automatically)
LOG_FILE_NAME = SIUMP_internal_error

#l: name of file to write log database info(sufix with .log automatically). Input null to merge with internal error log
#e:
LOG_DB_NAME = SIUMP_database

#l: name of file to write log any request info(sufix with .log automatically). Input null to merge with internal error log
#e:
LOG_REQUEST_NAME = SIUMP_request

#l: name of php error file(suffix with .log automatically)
LOG_PHP_ERROR = php_errors

#c:==================================================================================================================================
#c: Rate limit
#c:==================================================================================================================================

#l: maximum number of splitted file to track rate limit
RATE_FILE_MAX_QUANT = 4

#l: maximum expiration time for record rate limit(syntax- ms|sec|min|hour)
RATE_RECORD_EXPIRATION = 1d



#c: IP rate limit

#l: minimum interval between request from same ip(syntax- ms|sec|min|h|d)
RATE_IP_MINIMUM_INTERVAL = 1sec

#l: maximum number of request can be done in one interval(syntax- number:ms|sec|min|h|d), e.g 100:30min mean 100 request at most in 30 min
RATE_IP_MAX_REQUEST_PER_INTERVAL = 100:30min

#l: maximum number of request can be done in one interval one ip can do(syntax- number:ms|sec|min|h|d)
RATE_IP_LOGIN_PER_INTERVAL = 10:30min

#l: time of penality when hit login rate limit(syntax- ms|sec|min|h|d)
RATE_IP_LOGIN_PENALTY = 5sec


#c: account rate limit

#l: maximum number of login can be done in one interval for same account(syntax-number:ms|sec|min|h|d) e.g 100:30min mean 100 login at most in 30 min
RATE_ACCOUNT_LOGIN_ATTEMPT_INTERVAL = 10:3min

#l: minimum interval between failed login from same account(syntax- ms|sec|min|h|d)
RATE_ACCOUNT_LOGIN_MINIMUM_INTERVAL = 15sec

#c: Rate limit Endpoint

#l: maximum number of login endpoint can take in one interval(syntax-number:ms|sec|min|h|d)
RATE_ENDPOINT_LOGIN = 10000:30sec

#l: maximum number of sign up endpoint can take in one interval(syntax-number:ms|sec|min|h|d)
RATE_ENDPOINT_SUBSCRIBE = 8000:1min

#l: maximum number of any image upload endpoint can take in one interval(syntax-number:ms|sec|min|h|d)
RATE_ENDPOINT_IMG_UPLOAD = 7500:2min

#c:==================================================================================================================================
#c: WEBSITE setting
#c:==================================================================================================================================
#c: l: web site host name, example: localhost
SERVER_NAME = localhost

#l: home page location, relative to Public_hmtl(leading / will have no effect)
HOME_PAGE_LOCATION = index.html

