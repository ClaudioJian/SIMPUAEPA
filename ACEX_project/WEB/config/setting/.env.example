#===================================================================================
# INFORMATION & USER GUIDE
#===================================================================================
#c: CRITICAL: Do not move or change the location of this file. If you must relocate it,
#c: update the corresponding path constants inside 'Include/ENV_const.h' and recompile.
#c: 
#c: Runtime Execution: All configurations declared below are evaluated at runtime. 
#c: You can modify them freely, but you must adhere to the formatting syntax below 
#c: to prevent application errors or unexpected parsing behavior.
#c:
#c: Compilation Note: These keys act as blueprints. To generate a fresh '.env' file 
#c: containing these values, edit this template (or '.env.example') and run setup.exe.

#===================================================================================
# SYSTEM FLAGS & SYNTAX DIRECTIVES
#===================================================================================
#c: #c: -> Comment Escape: Escapes processing flags (l:, r:, s:, e:, o:, f:). Use this 
#c:        prefix to write developer notes containing flag characters safely.
#c:
#c:  l: -> Label / Description: Displays a prompt explaining the value's purpose. 
#c:        The console output will automatically prefix this text as: "Please set {text}"
#c:
#c:  r: -> Required Input: Marks the parameter as mandatory. The setup wizard will 
#c:        block empty values and force user input.
#c:
#c:  s: -> Static / Read-Only: Fixes the variable to its default value. It cannot be 
#c:        modified by the operator at runtime and cannot be left blank.
#c:        (If existing previous data, the conflict can be solved in run time)
#c:
#c:  e: -> Empty / Optional: Explicitly allows an empty value. If the user enters 
#c:        "null", the parameter will bypass generation and won't be written to '.env'.
#c:
#c:  o: -> Options List: Provides a pipe-separated (`|`) list of valid choices. 
#c:        Operators must type a positive integer to pick an option. If no options, 
#c:        the flag is automatically ignored.
#c:
#c:  f: -> Script Execution: WARNING: DO NOT USE THIS FLAG INSIDE THIS FILE. Declaring 
#c:        execution routines here will corrupt the output structure of your '.env' file. 
#c:        To run setup scripts, declare them inside 'internal.cfg' instead.

#===================================================================================
# COMPILER RESTRICTIONS & VALIDATION RULES
#===================================================================================
#c: Flag Priority: Behavior modifiers (r, s, e) are mutually exclusive per variable. 
#c: If duplicate metadata flags are specified, only the final declared flag is used.
#c:
#c: Environment Integrity: Before adding or modifying environment keys, verify that 
#c: your backend/frontend applications and microservices are compatible with the new names.
#c:
#c: Memory Allocation: Key and value string lengths are constrained by hardware buffer sizes. 
#c: Adjust limits inside 'Include/ENV_const.h' and recompile if larger bounds are needed.
#c:
#c: Script Restrictions: The underlying interpreter natively executes '.php' files only.
#c: You can trigger .sql file via php script instead
#c:
#c: Naming Conventions: Environment variable keys cannot begin with numbers or restricted 
#c: special characters (e.g., [ ] , @ $ % \). For keys referencing files, standard system 
#c: file path rules apply (Note: this character validation filter is not entirely strict).
#===================================================================================

#c:====================================values=====================================================

#c: don't change this value's key name, unless you change in ENV_const.h and re-compile it.
#o: development|production|NULL
#l: Server environment. Affects the .env file suffix (NULL = without suffix) e.g., development -> .env.development
ENVIRONMENT = development

#c:==================================================================================================================================
#c: DATABASE CONFIGURATION
#c:==================================================================================================================================

#l: what application database you are using
#o: mysql
DATABASE_TYPE = mysql

#l:host of database, example: localhost, IP address, or domain name.
DATABASE_HOST = localhost

#l:name of database
DATABASE_NAME = SIMPUAEPA

#l:username to access database
DATABASE_USER = root

#l:password to access database
#r:
DATABASE_PASSWORD = password

#l:port to acess database
#e:
DATABASE_PORT = 3306

#c:==================================================================================================================================
#c: WEBSITE LOCATION
#c: not using yet, uncomment if you are using
#c:==================================================================================================================================
#c: l: web site url, example: http://localhost/simpuaepa
#WEBSITE_URL = http://localhost/simpuaepa

