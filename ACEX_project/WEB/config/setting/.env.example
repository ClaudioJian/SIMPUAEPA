#================================Information========================================
#c: Don't change location of this file where it is, except if you change values in ENV_const.h and re-compile it.
#c: All values in this file will be used in run time, so you can change them to fit your need. But make sure to follow the rules below, otherwise it may cause error or unexpected behavior.
#c: All values WILL be written into new .env file, to write, change in .env.example and run exe file again.

#========================================Flags====================================================

#c: the c: comment that escape special flags like l: r: s: o: f: and #c: itself. You can use it to write comment that contain those tags. It will be ignored by the program.
#c: the l: display text to explain what value is for. All will be prefixed with "Plese set {text}"
#c: the r: Mandatory input.
#c: the s: Read only value(use default and cannot be modified in run time). cannot be empty value 
#c: the e: allow user to skip that value when setting. if user enter "null", it will be ignored to write. 
#c: the o: mean option that can select, enter positive int to select. Each option are separate by "|". if no options after o:, this flag will be ignored.
#c: the f: The file to execute. PLEASE DON'T USE THIS FLAGS, it won't run, will be written into .env file and make .env file broken. Instead, use in internal.cfg then run the exe file.

#c:==============================Restriction======================================================
#c: flags r,s,e can only exist once for each value, if there are more than one, only the last one will be used.
#c: if you are changing key name or add new, ensure others program are compatible with the change.

#c: key and value have size restriction, change it in ENV_const.h and re-compile it if you want to change.
#c: example: if you want go folder upper, change to ..//path/to/destination/file
#c: Only support .php and .sql file to run!

#c: Key name cannot: start with digit, special character [ , ] @ $ % \ and many others. Except for files, only invalid char for path are prohibided(Note: some invalid word/chr isn't included)
#c: if there are other same flags, only last one will be used for next new value.

#c:====================================values=====================================================

#c: don't change this value's key name, unless you change in ENV_const.h and re-compile it.
#o: development|production|test|NULL
#l: Server environment. Affects the .env file suffix (NULL = without suffix) e.g., development -> .env.development
ENVIROMENT = development

#c:==================================================================================================================================
#c: DATABASE CONFIGURATION
#c:==================================================================================================================================

#l: what application database you are using
#o: mysql
DATABASE_TYPE = mysql

#l:host of database, example: localhost, IP address, or domain name.
DATABASE_HOST = localhost

#l:name of database
DATABASE_NAME = SIMPUAEPA

#l:username to access database
DATABASE_USER = root

#l:password to access database
#r:
DATABASE_PASSWORD = password

#l:port to acess database
#e:
DATABASE_PORT = 3306

#c:==================================================================================================================================
#c: WEBSITE LOCATION
#c: not using yet, uncomment if you are using
#c:==================================================================================================================================
#c: l: web site url, example: http://localhost/simpuapepa
#WEBSITE_URL = http://localhost/simpuapepa

